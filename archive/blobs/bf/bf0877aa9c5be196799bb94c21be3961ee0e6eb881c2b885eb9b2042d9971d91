<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RAZR SLIDE R9 | 双轴机构审查</title>
<style>:root{color-scheme:dark}*{box-sizing:border-box}body{font-family:system-ui,'Noto Sans CJK SC',sans-serif;background:#0b1220;color:#e8effa;margin:0;padding:25px}h1{font-size:24px;margin:0 0 5px}.sub{color:#9caec8;font-size:13px;line-height:1.6}.main{display:grid;grid-template-columns:1fr 330px;gap:22px;max-width:1320px;margin:20px auto}svg{background:#111e30;border:1px solid #334b64;border-radius:12px;width:100%;height:min(78vh,810px)}.panel{border:1px solid #334b64;padding:18px;border-radius:12px;background:#122037}.hint{color:#b0c0d5;margin:12px 0;line-height:1.6;font-size:14px}.v{font-weight:750;font-size:20px;color:#9ce9dc}.test{font-size:12px;line-height:1.8;color:#f2d18a}input[type=range]{width:100%;accent-color:#43c9dc}label{display:flex;justify-content:space-between;margin-top:18px}#stagebtn{margin-top:12px;width:100%;border:1px solid #517398;border-radius:9px;background:#1e3b54;color:#e8effa;padding:10px}.metric{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid #29405a}small{color:#9cb5ca}.legend{display:flex;gap:15px;flex-wrap:wrap;font-size:12px;margin-top:10px;color:#b4cbe0}.dot{width:11px;height:11px;display:inline-block;border-radius:2px;margin-right:5px}.warning{border-left:3px solid #ff9c67;padding-left:12px;margin-top:20px;color:#f7c6af}@media(max-width:850px){.main{grid-template-columns:1fr}svg{height:550px}} </style>
</head><body><div style="max-width:1320px;margin:auto"><h1>RAZR SLIDE R9 · 等尺寸双舱双轴运动学</h1><div class="sub">仅是可复算的二维机构示意。屏幕、机架、储屏通道的基准尺寸与7个STEP统一；尚未验证真实OLED、装配锁止与受力。</div><div class="main"><div><svg viewBox="0 0 420 785" id="drawing" aria-label="R9 motion schematic"></svg><div class="legend"><span><i class="dot" style="background:#7790aa"></i>A固定</span><span><i class="dot" style="background:#348ab2"></i>B上滑核心</span><span><i class="dot" style="background:#55e1cb"></i>OLED</span><span><i class="dot" style="background:#f5c569"></i>A支撑板</span><span><i class="dot" style="background:#78abfa"></i>B整体板</span><span><i class="dot" style="background:#ff8866"></i>终端推块</span></div></div><div class="panel"><h2 style="font-size:17px">机构控制</h2><div class="hint">先将收纳时位于后下层的B完整机身上滑到终点；滑到终点后才允许B核心前后就位。</div><label>① 纵向行程 Y <b id="stxt">0.00 mm</b></label><input id="s" type="range" min="0" max="79.75" step="0.05" value="0"><label>② 末端深度 Z <b id="ztxt">0%</b></label><input id="dock" type="range" min="0" max="100" step="1" value="0" disabled><div class="hint" id="state"></div><button id="stagebtn">自动演示全部动作</button><h3 style="margin:25px 0 4px;font-size:16px">实时核对</h3><div class="metric"><span>OLED中性路径</span><b id="L" class="v"></b></div><div class="metric"><span>两舱展开高度</span><b id="H"></b></div><div class="metric"><span>B核心前后位置</span><b id="Z"></b></div><div class="metric"><span>B整板抬升量</span><b id="lift"></b></div><div class="metric"><span>A/B最终屏下缝</span><b>0.65 mm</b></div><div class="warning">红线：此模型在中间滑动过程中禁止触摸操作；实际抗压、锁止、密封、FPC、OEM电池与4700mAh均未放行。</div></div></div></div><script>
const S=79.75,R=5.2,front=10,rear=-.4,H=94.25,pi=Math.PI;const s=document.getElementById('s'),dock=document.getElementById('dock'),draw=document.getElementById('drawing');
const sx=z=>220+z*9.4,sy=y=>756-y*4.06;const rect=(z0,y0,z1,y1,color,op=.65)=>`<rect x="${sx(z0)}" y="${sy(y1)}" width="${(z1-z0)*9.4}" height="${(y1-y0)*4.06}" fill="${color}" fill-opacity="${op}" stroke="${color}" stroke-width=".5"/>`;
function show(){let v=parseFloat(s.value),d=v>=S-1e-4?parseFloat(dock.value)/100:0;dock.disabled=v<S-1e-4;if(dock.disabled){dock.value=0;d=0}let zd=8.5*d,lf=Math.min(1.15,Math.max(0,zd-7.35)),U=H+v-R-1,tail=1+2*v,L=(U-1)+(U-tail)+pi*R;let svg='';
for(let y=0;y<=175;y+=25)svg+=`<line x1="60" x2="370" y1="${sy(y)}" y2="${sy(y)}" stroke="#304a62" stroke-width=".6"/><text x="38" y="${sy(y)+4}" font-size="11" fill="#99aec6">${y}</text>`;
svg+=rect(0,0,7.19,75.75,'#71869e',.39)+rect(0,75.75,7.19,86,'#71869e',.23);
svg+=rect(-8.5+zd,v+18.5,-1.31+zd,v+77.25,'#348ab2',.40)+rect(-8.5+zd,v,-1.31+zd,v+18.5,'#348ab2',.27);
svg+=rect(8.97,1,9.77,87.8,'#f5c569',.89)+rect(7.57+lf,v+8.70,8.62+lf,U,'#78abfa',.86);
for(let y of [22,70])svg+=rect(-1.31+zd,v+y,.22+zd,v+y+2,'#ff8866',.91);
let start=`M${sx(front)},${sy(1)} L${sx(front)},${sy(U)}`;let arc='';for(let i=0;i<=45;i++){let a=i*pi/45;arc+=` L${sx((front+rear)/2+R*Math.cos(a))},${sy(U+R*Math.sin(a))}`;}let path=start+arc+` L${sx(rear)},${sy(tail)}`;
svg+=`<path d="${path}" stroke="#55e1cb" stroke-width="3" fill="none" stroke-linejoin="round" stroke-linecap="round"/>`;
svg+=`<text x="60" y="32" font-size="15" fill="#e8effa">B上滑 ${v.toFixed(2)} mm / Z就位 ${zd.toFixed(2)} mm</text>`;
svg+=`<text x="60" y="52" font-size="12" fill="#b4c7db">纵横比按物理毫米坐标绘制，宽度仅剖面深度</text>`;
draw.innerHTML=svg;document.getElementById('stxt').textContent=v.toFixed(2)+' mm';document.getElementById('ztxt').textContent=Math.round(d*100)+'%';document.getElementById('L').textContent=L.toFixed(6)+' mm';document.getElementById('H').textContent=(94.25+v).toFixed(2)+' mm';document.getElementById('Z').textContent=zd.toFixed(2)+' mm';document.getElementById('lift').textContent=lf.toFixed(2)+' mm';document.getElementById('state').textContent=(v<S-1e-4?'纵向滑动阶段；深度就位被互锁禁止':d<1?'纵向已到终点；深度就位尚未锁止':'末端齐平；锁止仍是未通过的代理几何');}
s.addEventListener('input',show);dock.addEventListener('input',show);let run=false;document.getElementById('stagebtn').addEventListener('click',()=>{if(run)return;run=true;let f=0;function tick(){if(f<=100){s.value=(S*f/100).toFixed(2);dock.value=0;f++;show();setTimeout(tick,25)}else if(f<=180){s.value=S;dock.value=Math.min(100,(f-100)*1.25);f++;show();setTimeout(tick,25)}else{run=false}}tick()});show();</script></body></html>