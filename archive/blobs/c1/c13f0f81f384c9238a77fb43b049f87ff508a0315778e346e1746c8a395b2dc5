<!doctype html><html lang="zh-Hans"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>R14 双侧实体坐实机构 - 离线运动学</title>
<style>body{margin:0;background:#101c29;color:#edf6ff;font:14px system-ui,'Noto Sans CJK SC',sans-serif}header{padding:24px 5%;background:#14263a;border-bottom:1px solid #29445d}h1{margin:0 0 5px;font-size:25px}main{display:grid;grid-template-columns:1fr 340px;gap:20px;padding:20px 4%}section{background:#19293b;border:1px solid #31506a;border-radius:13px;padding:20px}.buttons{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 22px}button{padding:9px 12px;background:#2c5675;color:white;border:1px solid #4b779a;border-radius:7px;cursor:pointer}button:focus{outline:2px solid #65b9ef}input[type=range]{width:100%}label{display:block;margin-top:14px;font-size:13px;color:#c4d6e4}small{color:#89a6bd}.row{display:flex;align-items:center;justify-content:space-between;gap:10px}output{font-variant-numeric:tabular-nums;color:#6fe0be}#status{font-size:18px;font-weight:bold;padding:10px 0}svg{width:100%;height:410px}table{width:100%;border-collapse:collapse}td{padding:8px;border-bottom:1px solid #30445c}tr td:last-child{text-align:right;font-variant-numeric:tabular-nums}footer{padding:10px 5% 30px;color:#99a9bc}@media(max-width:850px){main{grid-template-columns:1fr}}.warn{color:#ffb287}</style></head>
<body><header><h1>R14 / 双侧承力接触 + 独立X释放</h1><div>离线几何查看器（局部简化机构；不是力学仿真、安全认证或完整手机）</div></header>
<main><section><h2>同基准横截面：Y行程 × X宽度</h2><svg id="scene" viewBox="0 0 850 410" aria-label="A rocker and B two bearing toes">
<rect width="850" height="410" fill="#15283c" rx="10"/><g id="world"></g></svg><div class="row"><span>实际机身滑动行程 s</span><output id="sv"></output></div><input id="s" type="range" min="78.95" max="79.95" step="0.001" value="79.35"><div class="buttons"><button id="pre">终点前 0.40</button><button id="seat">按当前公差坐实</button><button id="reset">反向锁闭</button></div><div class="warn">注意：已实际接触的判定采用理想刚体零间隙，不等于真实接触压力达到锁止要求。</div></section>
<section><h2>尺寸与故障输入</h2><label>左侧有效装配偏差 eL (mm) <output id="elv"></output></label><input id="el" type="range" min="-0.2" max="0.2" step="0.025" value="0"><label>右侧有效装配偏差 eR (mm) <output id="erv"></output></label><input id="er" type="range" min="-0.2" max="0.2" step="0.025" value="0"><label><input id="manual" type="checkbox"> 请求独立手动开锁（非连续滑动自动开锁）</label><label><input id="missingL" type="checkbox"> 左侧承力舌片缺失</label><label><input id="missingR" type="checkbox"> 右侧承力舌片缺失</label><label><input id="badSpring" type="checkbox"> 右侧坐实传力/弹簧失效</label><div id="status"></div><table><tr><td>公差下实际双接触终点</td><td id="st"></td></tr><tr><td>浮动梁角</td><td id="angle"></td></tr><tr><td>左端间隙</td><td id="gl"></td></tr><tr><td>右端间隙</td><td id="gr"></td></tr><tr><td>左侧守门件</td><td id="lk"></td></tr><tr><td>右侧守门件</td><td id="rk"></td></tr><tr><td>是否允许进入Z向</td><td id="za"></td></tr></table></section></main>
<footer>模型源 r14_model.py；符号坐标 X横向、Y上滑、Z正面方向。滑动实际终点因装配偏差可能偏离79.75mm；只有满足理想双接触且另行发出释放命令才显示可进入Z方向。实际承力等效梁未通过刚度筛查。</footer>
<script>
const E=id=>document.getElementById(id), S=79.75, a=34.5;
function calc(){let s=+E('s').value,eL=+E('el').value,eR=+E('er').value,missL=E('missingL').checked,missR=E('missingR').checked;
const stop=S-(eL+eR)/2;
let k=0, leadL=s-S+eL,leadR=s-S+eR;
if(missL&&!missR) k=Math.min(Math.tan(.48*Math.PI/180),Math.max(0,leadR/a));
else if(missR&&!missL) k=Math.max(-Math.tan(.48*Math.PI/180),Math.min(0,-leadL/a));
else if(!missR&&!missL){if(s>=stop)k=(eR-eL)/(2*a);else if(leadL>0||leadR>0)k=leadL>leadR?-Math.min(leadL/a,Math.tan(.48*Math.PI/180)):Math.min(leadR/a,Math.tan(.48*Math.PI/180));}
let gapL=missL?null:93.9-k*a-(s+14.15+eL),gapR=missR?null:93.9+k*a-(s+14.15+eR);
let L=gapL!==null&&Math.abs(gapL)<1e-7,R=gapR!==null&&Math.abs(gapR)<1e-7&&!E('badSpring').checked;
let allow=L&&R&&E('manual').checked&&s>=stop-1e-9;
const px=x=>425+x*5.4, py=y=>295-(y-93.9)*145;
let line=`<line x1="${px(-35)}" y1="${py(93.9-k*35)}" x2="${px(35)}" y2="${py(93.9+k*35)}" stroke="#62dbbb" stroke-width="8" stroke-linecap="round"/>`;
let toe=(sign,err,missing,name)=>{if(missing)return '';let x=sign*a,tip=s+14.15+err;return `<rect x="${px(x-.55)}" y="${py(tip)}" width="${px(x+.55)-px(x-.55)}" height="${py(tip-.65)-py(tip)}" fill="#66b7ed" stroke="#c1ecff" stroke-width="1"/><text x="${px(x)}" y="335" fill="#deebf4" font-size="17" text-anchor="middle">${name}</text>`};
E('world').innerHTML=`<line x1="65" y1="${py(93.9)}" x2="785" y2="${py(93.9)}" stroke="#637788" stroke-dasharray="6 7"/>${line}${toe(-1,eL,missL,'B左承力舌片')}${toe(1,eR,missR,'B右承力舌片')}<circle cx="425" cy="${py(93.9)}" r="5" fill="#f7db85"/><text x="425" y="38" text-anchor="middle" font-size="20" fill="#daebf8">A舱接触横梁：两侧真实间隙 ${gapL===null?'—':gapL.toFixed(3)} / ${gapR===null?'—':gapR.toFixed(3)} mm</text>`;
const fmt=x=>x===null?'缺失':x.toFixed(3)+' mm';for(const [id,v] of [['sv',s.toFixed(3)+' mm'],['elv',eL.toFixed(3)],['erv',eR.toFixed(3)],['st',stop.toFixed(3)+' mm'],['angle',(Math.atan(k)*180/Math.PI).toFixed(3)+'°'],['gl',fmt(gapL)],['gr',fmt(gapR)],['lk',L?'就位':'常闭阻挡'],['rk',R?'就位':'常闭阻挡'],['za',allow?'理想允许':'禁止']])E(id).textContent=v;
E('status').innerHTML=allow?'<span style="color:#64dfb9">理想几何：双侧允许释放</span>':'<span style="color:#ff927b">机械常闭：不允许前后就位</span>';}
for(let id of ['s','el','er','manual','missingL','missingR','badSpring']) E(id).addEventListener('input',calc);
E('pre').onclick=()=>{E('s').value=79.35;E('manual').checked=true;calc()};E('seat').onclick=()=>{E('s').value=Math.max(78.95,Math.min(79.95,S-(+E('el').value+ +E('er').value)/2));calc()};E('reset').onclick=()=>{E('s').value=79.25;E('manual').checked=false;calc()};calc();
</script></body></html>